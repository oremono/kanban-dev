{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@modules/*": ["./src/modules/*"],
      "@modules": ["./src/modules"],
      "@operations/*": ["./src/operations/*"],
      "@operations": ["./src/operations"],
      "@helpers/*": ["./src/helpers/*"],
      "@helpers": ["./src/helpers"],
      "@hooks/*": ["./src/hooks/*"],
      "@hooks": ["./src/hooks"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
